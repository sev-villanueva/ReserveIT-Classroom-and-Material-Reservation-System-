# Copy this file to .env and fill in your own values. Never commit .env.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=ReserveIT

# The web app's day-to-day account (created by: python manage.py setup-roles)
DB_USER=reserveit_app
DB_PASSWORD=choose_a_password_for_the_app

# The account that owns the tables; used only by init-db, seed, grants, and reset-db
DB_OWNER_USER=reserveit_owner
DB_OWNER_PASSWORD=choose_a_different_password

# Extra accounts created by setup-roles (read-only reports, and maintenance)
DB_REPORT_PASSWORD=choose_a_third_password
DB_DBA_PASSWORD=choose_a_fourth_password

# PostgreSQL superuser, used ONLY by setup-roles. Its password is typed when asked and never saved.
DB_SUPERUSER=postgres

# Flask session signing key: use any long random string
SECRET_KEY=change-me-to-a-long-random-string

# Users with unpaid penalties above this amount cannot make new reservations
PENALTY_THRESHOLD=500
